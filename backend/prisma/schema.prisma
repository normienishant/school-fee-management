generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLERK)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments   Payment[]   @relation("receivedBy")
  auditLogs  AuditLog[]  @relation("staffAudit")
}

model Student {
  id               String   @id @default(cuid())
  rollNumber       String   @unique
  name             String
  gradeClass       String
  section          String   @default("A")
  enrollmentDate   DateTime @default(now())
  withdrawalDate   DateTime?
  parentName       String
  parentPhone      String
  parentEmail      String?
  totalFee         Float    @default(0)
  paidFee          Float    @default(0)
  pendingBalance   Float    @default(0)
  status           Status   @default(ACTIVE)
  feeBreakdown     Json?
  openingBalance   Float    @default(0)
  siblings         String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     Payment[]
  instalments      Instalment[]
  auditLogs        AuditLog[]
  reminders        Reminder[]
}

model Instalment {
  id         String   @id @default(cuid())
  studentId  String
  dueDate    DateTime
  amount     Float
  paid       Boolean  @default(false)
  paidDate   DateTime?
  lateFee    Float    @default(0)
  lateFeePaid Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student  @relation(fields: [studentId], references: [id])
}

model Payment {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  studentId     String
  amount        Float
  paymentMode   PaymentMode
  transactionRef String?
  feeType       String
  receivedBy    String
  date          DateTime  @default(now())
  notes         String?
  reversalFor   String?
  isVoid        Boolean   @default(false)
  voidReason    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student  @relation(fields: [studentId], references: [id])
  staff         Staff    @relation("receivedBy", fields: [receivedBy], references: [id])
  auditLogs     AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  academicYear String   @unique
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentArchives StudentArchive[]
}

model StudentArchive {
  id            String   @id @default(cuid())
  studentId     String
  name          String
  rollNumber    String
  gradeClass    String
  totalFee      Float
  paidFee       Float
  pendingBalance Float
  openingBalance Float
  feeBreakdown  Json?
  archivedAt    DateTime @default(now())
  sessionId     String

  session       Session  @relation(fields: [sessionId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  staffId    String
  studentId  String?   // optional
  paymentId  String?   // optional
  action     String
  resource   String
  recordId   String
  changes    Json?
  createdAt  DateTime @default(now())

  staff      Staff    @relation("staffAudit", fields: [staffId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id])
  payment    Payment? @relation(fields: [paymentId], references: [id])
}

model FeeStructure {
  id              String   @id @default(cuid())
  gradeClass      String
  effectiveFrom   DateTime @default(now())
  feeHeads        Json
  discountRules   Json?
  lateFeeRules    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReceiptCounter {
  id         String @id @default("single")
  currentNumber Int  @default(0)
}

model Reminder {
  id         String   @id @default(cuid())
  studentId  String
  channel    ReminderChannel
  message    String
  status     ReminderStatus
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id])
}

enum Role {
  ADMIN
  CLERK
}

enum Status {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  REFUND
}

enum ReminderChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}